{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_model_data",
    "cases": [
      {
        "when": 1,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/hobbit_essence"
        }
      },
      {
        "when": 2,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/copper_essence"
        }
      },
      {
        "when": 3,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/fishfolk_essence"
        }
      },
      {
        "when": 4,
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/elf_essence"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/glass_bottle"
    }
  }
}